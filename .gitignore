.venv/
__pycache__/
*.py[cod]
data/
artifacts/
.logs/
.cache/
conf/local.toml
.pytest_cache/
# Score files and neighbour tables are deliverables passed to member three and
# member four out of band: 467 MB each, ~3 GB in total. Keep the small JSON/CSV
# summaries in results/ tracked, ignore the bulk.
results/*.csv
results/*.npz
results/*.parquet
# ...but the small summary tables are deliverables for member four, keep them.
!results/table_*.csv
# v2 deliverables are small (~2 MB) and must travel with the repo:
# pred_test.csv is the file member one/four score, pred_val.csv the val twin.
!results/pred_*.csv
# Submission file for the teacher: test_pairs with pred_rating appended.
!results/test_pairs_predicted.csv
!results/v2_table_*.csv

# Historical debug leftovers at the project root.
tmp*/
pip-*/
